<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap mp rescap">
  <Identity Name="Vita3KUWP" Publisher="CN=Vita3K-UWP" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="19b18280-8d0b-4566-86f9-640822a81a36" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>ReVita</DisplayName><PublisherDisplayName>Vita3K-UWP contributors</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo><Description>ReVita - PS Vita emulation for Xbox, powered by Vita3K</Description></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" /></Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications><Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Vita3KUWP.App">
    <uap:VisualElements DisplayName="ReVita" Description="ReVita - PS Vita emulation for Xbox, powered by Vita3K" BackgroundColor="#07060F" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
      <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="ReVita"><uap:ShowNameOnTiles><uap:ShowOn Tile="square150x150Logo"/></uap:ShowNameOnTiles></uap:DefaultTile>
      <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#07060F" />
    </uap:VisualElements>
  </Application></Applications>
  <Capabilities><Capability Name="internetClient" /><Capability Name="codeGeneration" /><uap:Capability Name="removableStorage" /><rescap:Capability Name="broadFileSystemAccess" /><rescap:Capability Name="expandedResources" /></Capabilities>
</Package>
