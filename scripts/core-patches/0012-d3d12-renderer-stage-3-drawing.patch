+    std::string rebuilt = "\n";
+    std::vector<bool> used(inputs.size(), false);
+    int unused = 0;
+    for (const StructMember &out : outputs) {
+        bool found = false;
+        for (size_t i = 0; i < inputs.size(); i++) {
+            if (!used[i] && inputs[i].semantic == out.semantic) {
+                rebuilt += inputs[i].text + "\n";
+                used[i] = true;
+                found = true;
+                break;
+            }
+        }
+        if (found)
+            continue;
+        if (out.semantic.rfind("SV_", 0) == 0 && out.semantic != "SV_POSITION")
+            continue; // clip distances and the like need no fragment-side twin
+        // declare it under another name so nothing reads it
+        std::string line = out.text;
+        const size_t colon = line.rfind(':');
+        std::string decl = line.substr(0, colon);
+        while (!decl.empty() && decl.back() == ' ')
+            decl.pop_back();
+        const size_t space = decl.find_last_of(" \t");
+        if (space == std::string::npos)
+            continue;
+        std::string type_part = decl.substr(0, space + 1);
+        // interpolation qualifiers of an unused input do not matter
+        for (const char *qualifier : { "nointerpolation ", "noperspective ", "centroid ", "sample " }) {
+            size_t q;
+            while ((q = type_part.find(qualifier)) != std::string::npos)
+                type_part.erase(q, std::strlen(qualifier));
+        }
+        if (out.semantic == "SV_POSITION")
+            rebuilt += fmt::format("{}revita_unused_{} : SV_Position;\n", type_part, unused++);
+        else
+            rebuilt += fmt::format("{}revita_unused_{} : {};\n", type_part, unused++, line.substr(colon + 1, line.rfind(';') - colon - 1));
+    }
