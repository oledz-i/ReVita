+// fragment shader reading TEXCOORD3 must find it in the register the vertex
+// shader wrote it to. SPIRV-Cross packs each stage's own variables in order,
+// so the fragment input struct is rebuilt in the vertex output order, with
+// the vertex outputs it does not read declared and left unused.
+static std::string link_fragment_inputs(const std::string &fragment, const std::string &vertex) {
+    std::vector<StructMember> outputs, inputs;
+    size_t vb, ve, fb, fe;
+    if (!parse_struct(vertex, "SPIRV_Cross_Output", outputs, vb, ve) || !parse_struct(fragment, "SPIRV_Cross_Input", inputs, fb, fe))
+        return fragment;
