+
+// The members of "struct <name> { ... };" in the HLSL, and where it sits
+static bool parse_struct(const std::string &hlsl, const std::string &name, std::vector<StructMember> &members, size_t &begin, size_t &end) {
+    const std::string head = "struct " + name;
+    size_t at = hlsl.find(head + "\n");
+    if (at == std::string::npos)
+        at = hlsl.find(head + "\r\n");
+    if (at == std::string::npos)
+        return false;
+    const size_t open = hlsl.find('{', at);
+    const size_t close = hlsl.find("};", open);
+    if (open == std::string::npos || close == std::string::npos)
+        return false;
+    begin = open + 1;
+    end = close;
+    members.clear();
+    size_t line_start = begin;
+    while (line_start < end) {
+        size_t line_end = hlsl.find('\n', line_start);
