+    if (wait_now) {
+        (void)vk_state.device.waitForFences(s_present.fence, VK_TRUE, std::numeric_limits<uint64_t>::max());
+        vk_state.device.resetFences(s_present.fence);
+    } else {
+        s_present.fence_pending = true;
+    }
 #ifdef VITA3K_UWP
     s_present.presents++;
