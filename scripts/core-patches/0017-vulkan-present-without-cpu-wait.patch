@@ -1512,6 +1516,12 @@ static void libretro_copy_frame_for_presentation(renderer::vulkan::VKState &vk_s
             .level = vk::CommandBufferLevel::ePrimary, .commandBufferCount = 1 })[0];
         s_present.fence = vk_state.device.createFence({});
     }
+    // the previous copy: its command buffer is recorded again below
+    if (s_present.fence_pending) {
+        (void)vk_state.device.waitForFences(s_present.fence, VK_TRUE, std::numeric_limits<uint64_t>::max());
+        vk_state.device.resetFences(s_present.fence);
+        s_present.fence_pending = false;
+    }
 
     int target = 0;
     {
@@ -1689,15 +1699,29 @@ static void libretro_copy_frame_for_presentation(renderer::vulkan::VKState &vk_s
         .image = image.image, .subresourceRange = range };
