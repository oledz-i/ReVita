+// ---------------------------------------------------------------------------
+// Fault guard. Without a debug layer the console's driver does not reject a
+// bad call, it faults inside it. Every entry point runs under SEH: a fault
+// drops that one draw (or upload, or submit), names the step in the log and
+// the game keeps running. After kMaxFaults the draw path turns itself off and
+// the screen comes from guest memory, as the other renderers' fallback does.
+
+namespace {
+std::atomic<int> g_faults{ 0 };
+constexpr int kMaxFaults = 32;
+
+bool draw_path_off() {
+    return g_faults.load(std::memory_order_relaxed) >= kMaxFaults;
+}
+
+} // namespace
+
+#ifdef _MSC_VER
+// No C++ objects in here: SEH and unwinding don't mix in one function
+bool run_guarded(void (*fn)(void *), void *context, unsigned long *code) {
+    __try {
+        fn(context);
+        return true;
+    } __except (*code = GetExceptionCode(), (*code == EXCEPTION_ACCESS_VIOLATION || *code == EXCEPTION_ILLEGAL_INSTRUCTION || *code == EXCEPTION_INT_DIVIDE_BY_ZERO || *code == EXCEPTION_STACK_OVERFLOW) ? EXCEPTION_EXECUTE_HANDLER : EXCEPTION_CONTINUE_SEARCH) {
+        return false;
+    }
+}
+#else
+bool run_guarded(void (*fn)(void *), void *context, unsigned long *) {
+    fn(context);
+    return true;
+}
+#endif
+
+namespace {
+
+void note_fault(D3D12State &state, const char *what, unsigned long code) {
+    const int faults = g_faults.fetch_add(1) + 1;
+    LOG_ERROR("Direct3D 12: the driver faulted (0x{:08X}) in {}; that step is skipped ({} of {})", code, what, faults, kMaxFaults);
+    if (state.drawer) {
+        // the open command list may be half written: throw it away
+        Drawer &d = *state.drawer;
+        if (d.open) {
+            d.open = false;
+            unsigned long ignored = 0;
+            run_guarded([](void *p) { static_cast<Drawer *>(p)->list->Close(); }, &d, &ignored);
+        }
+        d.bound = false;
+        d.bound_target = 0;
+    }
+    if (faults == kMaxFaults)
+        LOG_ERROR("Direct3D 12: too many driver faults; drawing is off for this game and the screen comes from memory");
+}
+} // namespace
+
+void sync_texture(D3D12State &state, renderer::Context &ctx, uint32_t index, const SceGxmTexture &texture, MemState &mem) {
+    if (draw_path_off())
+        return;
+    struct Args {
+        D3D12State &state;
+        renderer::Context &ctx;
+        uint32_t index;
+        const SceGxmTexture &texture;
+        MemState &mem;
+    } args{ state, ctx, index, texture, mem };
+    unsigned long code = 0;
+    if (!run_guarded([](void *p) { auto &a = *static_cast<Args *>(p); sync_texture_impl(a.state, a.ctx, a.index, a.texture, a.mem); }, &args, &code))
+        note_fault(state, "a texture upload", code);
+}
+
+void set_context(D3D12State &state, renderer::Context &ctx, MemState &mem) {
+    if (draw_path_off()) {
+        static_cast<D3D12Context &>(ctx).target = 0;
+        return;
+    }
+    struct Args {
+        D3D12State &state;
+        renderer::Context &ctx;
+        MemState &mem;
+    } args{ state, ctx, mem };
+    unsigned long code = 0;
+    if (!run_guarded([](void *p) { auto &a = *static_cast<Args *>(p); set_context_impl(a.state, a.ctx, a.mem); }, &args, &code)) {
+        static_cast<D3D12Context &>(ctx).target = 0;
+        note_fault(state, "starting a scene", code);
+    }
+}
+
+void end_scene(D3D12State &state, renderer::Context &ctx) {
+    struct Args {
+        D3D12State &state;
+        renderer::Context &ctx;
+    } args{ state, ctx };
+    unsigned long code = 0;
+    if (!run_guarded([](void *p) { auto &a = *static_cast<Args *>(p); end_scene_impl(a.state, a.ctx); }, &args, &code))
+        note_fault(state, "submitting a scene", code);
+}
+
+void draw(D3D12State &state, renderer::Context &ctx, SceGxmPrimitiveType type, SceGxmIndexFormat format,
+    const void *indices, uint32_t count, uint32_t instance_count, MemState &mem) {
+    if (draw_path_off())
+        return;
+    struct Args {
+        D3D12State &state;
+        renderer::Context &ctx;
+        SceGxmPrimitiveType type;
+        SceGxmIndexFormat format;
+        const void *indices;
+        uint32_t count;
+        uint32_t instance_count;
+        MemState &mem;
+    } args{ state, ctx, type, format, indices, count, instance_count, mem };
+    unsigned long code = 0;
+    if (!run_guarded([](void *p) { auto &a = *static_cast<Args *>(p); draw_impl(a.state, a.ctx, a.type, a.format, a.indices, a.count, a.instance_count, a.mem); }, &args, &code))
+        note_fault(state, "a draw", code);
+}
+
+bool find_display_target(D3D12State &state, uint32_t address, ID3D12Resource *&color, uint32_t &color_state, uint32_t &width, uint32_t &height) {
+    if (draw_path_off())
+        return false;
+    struct Args {
+        D3D12State &state;
+        uint32_t address;
+        ID3D12Resource *&color;
+        uint32_t &color_state;
+        uint32_t &width;
+        uint32_t &height;
+        bool found;
+    } args{ state, address, color, color_state, width, height, false };
+    unsigned long code = 0;
+    if (!run_guarded([](void *p) { auto &a = *static_cast<Args *>(p); a.found = find_display_target_impl(a.state, a.address, a.color, a.color_state, a.width, a.height); }, &args, &code)) {
+        note_fault(state, "submitting the frame's draws", code);
+        return false;
+    }
+    return args.found;
+}
+
+bool draw_faulted_off() {
+    return draw_path_off();
+}
+
+void note_present_fault(unsigned long code) {
+    const int faults = g_faults.fetch_add(1) + 1;
+    LOG_ERROR("Direct3D 12: the driver faulted (0x{:08X}) presenting a drawn frame; showing the frame from memory ({} of {})", code, faults, kMaxFaults);
+}
