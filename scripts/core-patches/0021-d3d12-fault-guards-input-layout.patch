+// The vertex shader's input signature, read from its DXBC (ISGN chunk). The
+// input layout is checked against it before a pipeline is made: a semantic the
+// shader reads but the layout lacks, or a duplicate, is a description the
+// console's driver takes as is and may fault on.
+struct ShaderInput {
+    uint32_t index; // TEXCOORD<index>
+    uint32_t type; // 1 uint, 2 sint, 3 float
+};
+
+std::vector<ShaderInput> read_vertex_inputs(const std::vector<uint8_t> &dxbc) {
+    std::vector<ShaderInput> inputs;
+    const auto u32 = [&](size_t at) -> uint32_t {
+        if (at + 4 > dxbc.size())
+            return 0;
+        uint32_t v;
+        std::memcpy(&v, dxbc.data() + at, 4);
+        return v;
+    };
+    if (dxbc.size() < 32 || std::memcmp(dxbc.data(), "DXBC", 4) != 0)
+        return inputs;
+    const uint32_t chunks = u32(28);
+    for (uint32_t c = 0; c < chunks && c < 64; c++) {
+        const uint32_t offset = u32(32 + c * 4);
+        if (offset + 8 > dxbc.size())
+            break;
+        if (std::memcmp(dxbc.data() + offset, "ISGN", 4) != 0)
+            continue;
+        const size_t data = offset + 8;
+        const uint32_t count = u32(data);
+        for (uint32_t i = 0; i < count && i < 64; i++) {
+            const size_t entry = data + 8 + i * 24;
+            if (entry + 24 > dxbc.size())
+                break;
+            const uint32_t name = u32(entry);
+            const uint32_t system_value = u32(entry + 8);
+            if (system_value != 0) // SV_VertexID and the like come from the GPU
+                continue;
+            if (data + name >= dxbc.size())
+                continue;
+            const char *text = reinterpret_cast<const char *>(dxbc.data() + data + name);
+            const size_t left = dxbc.size() - (data + name);
+            if (strnlen(text, left) == left)
+                continue;
+            if (strcmp(text, "TEXCOORD") != 0)
+                continue;
+            inputs.push_back({ u32(entry + 4), u32(entry + 12) });
+        }
+        break;
+    }
+    return inputs;
+}
+
+const std::vector<ShaderInput> &vertex_inputs(const std::vector<uint8_t> *vs) {
+    static std::unordered_map<const void *, std::vector<ShaderInput>> cache;
+    const auto it = cache.find(vs);
+    if (it != cache.end())
+        return it->second;
+    return cache.emplace(vs, read_vertex_inputs(*vs)).first->second;
+}
+
+uint32_t dxgi_component_bytes(DXGI_FORMAT format) {
+    switch (format) {
+    case DXGI_FORMAT_R8_UINT: case DXGI_FORMAT_R8_SINT: case DXGI_FORMAT_R8_UNORM: case DXGI_FORMAT_R8_SNORM:
+    case DXGI_FORMAT_R8G8_UINT: case DXGI_FORMAT_R8G8_SINT: case DXGI_FORMAT_R8G8_UNORM: case DXGI_FORMAT_R8G8_SNORM:
+    case DXGI_FORMAT_R8G8B8A8_UINT: case DXGI_FORMAT_R8G8B8A8_SINT: case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_SNORM:
+        return 1;
+    case DXGI_FORMAT_R16_UINT: case DXGI_FORMAT_R16_SINT: case DXGI_FORMAT_R16_UNORM: case DXGI_FORMAT_R16_SNORM: case DXGI_FORMAT_R16_FLOAT:
+    case DXGI_FORMAT_R16G16_UINT: case DXGI_FORMAT_R16G16_SINT: case DXGI_FORMAT_R16G16_UNORM: case DXGI_FORMAT_R16G16_SNORM: case DXGI_FORMAT_R16G16_FLOAT:
+    case DXGI_FORMAT_R16G16B16A16_UINT: case DXGI_FORMAT_R16G16B16A16_SINT: case DXGI_FORMAT_R16G16B16A16_UNORM: case DXGI_FORMAT_R16G16B16A16_SNORM: case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        return 2;
+    default:
+        return 4;
+    }
+}
+
+// slot for inputs no guest stream feeds: 16 zero bytes, read by every vertex
+constexpr UINT kZeroSlot = SCE_GXM_MAX_VERTEX_STREAMS;
+
