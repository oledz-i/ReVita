+
+void D3D12State::render_frame(DisplayState &display, const GxmState &gxm, MemState &mem) {
+    DisplayFrameInfo frame;
+    {
+        std::lock_guard<std::mutex> guard(display.display_info_mutex);
+        frame = display.next_rendered_frame;
+    }
+    if (!frame.base || frame.image_size.x <= 0 || frame.image_size.y <= 0)
+        return;
+    present_from_memory(frame.base.get(mem), frame.pitch, static_cast<uint32_t>(frame.image_size.x), static_cast<uint32_t>(frame.image_size.y));
+}
+
+bool D3D12State::present_from_memory(const void *pixels, uint32_t pitch, uint32_t width, uint32_t height) {
+    Impl &d = *impl;
+    if (!d.device || !pixels || width == 0 || height == 0 || pitch < width)
+        return false;
+    Impl::Slot &slot = d.slots[d.next];
+
+    // the slot's last copy has to be done before its upload buffer is written
+    if (slot.done && d.fence->GetCompletedValue() < slot.done) {
+        if (SUCCEEDED(d.fence->SetEventOnCompletion(slot.done, d.event)))
+            WaitForSingleObjectEx(d.event, 2000, FALSE);
+    }
+
+    if (!slot.texture || slot.width != width || slot.height != height) {
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC desc{};
+        desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        desc.Width = width;
+        desc.Height = height;
+        desc.DepthOrArraySize = 1;
+        desc.MipLevels = 1;
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        desc.SampleDesc.Count = 1;
+        desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        slot.texture.Reset();
+        if (FAILED(d.device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&slot.texture)))) {
+            LOG_ERROR("Direct3D 12: could not make a {}x{} frame texture", width, height);
+            return false;
+        }
+        slot.width = width;
+        slot.height = height;
+        slot.fresh = true;
+    }
+
+    const D3D12_RESOURCE_DESC desc = slot.texture->GetDesc();
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
+    UINT64 total = 0;
+    d.device->GetCopyableFootprints(&desc, 0, 1, 0, &footprint, nullptr, nullptr, &total);
+    if (!slot.upload || slot.upload_size < total) {
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC buffer{};
+        buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        buffer.Width = total;
+        buffer.Height = 1;
+        buffer.DepthOrArraySize = 1;
+        buffer.MipLevels = 1;
+        buffer.Format = DXGI_FORMAT_UNKNOWN;
+        buffer.SampleDesc.Count = 1;
+        buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        slot.upload.Reset();
+        if (FAILED(d.device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&slot.upload)))) {
+            LOG_ERROR("Direct3D 12: could not make an upload buffer of {} bytes", total);
+            return false;
+        }
+        slot.upload_size = total;
+    }
+
+    void *mapped = nullptr;
+    const D3D12_RANGE nothing_read{ 0, 0 };
+    if (FAILED(slot.upload->Map(0, &nothing_read, &mapped)))
+        return false;
+    const auto *src = static_cast<const uint8_t *>(pixels);
+    auto *dst = static_cast<uint8_t *>(mapped) + footprint.Offset;
+    for (uint32_t y = 0; y < height; ++y)
+        std::memcpy(dst + static_cast<size_t>(y) * footprint.Footprint.RowPitch, src + static_cast<size_t>(y) * pitch * 4, static_cast<size_t>(width) * 4);
+    slot.upload->Unmap(0, nullptr);
+
+    slot.allocator->Reset();
+    slot.list->Reset(slot.allocator.Get(), nullptr);
+    D3D12_RESOURCE_BARRIER barrier{};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = slot.texture.Get();
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    if (!slot.fresh && d.required != D3D12_RESOURCE_STATE_COPY_DEST) {
+        barrier.Transition.StateBefore = d.required;
+        barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        slot.list->ResourceBarrier(1, &barrier);
+    }
+    D3D12_TEXTURE_COPY_LOCATION to{};
+    to.pResource = slot.texture.Get();
+    to.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    to.SubresourceIndex = 0;
+    D3D12_TEXTURE_COPY_LOCATION from{};
+    from.pResource = slot.upload.Get();
+    from.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    from.PlacedFootprint = footprint;
+    slot.list->CopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+    if (d.required != D3D12_RESOURCE_STATE_COPY_DEST) {
+        barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        barrier.Transition.StateAfter = d.required;
+        slot.list->ResourceBarrier(1, &barrier);
+    }
+    slot.fresh = false;
+    if (FAILED(slot.list->Close()))
+        return false;
+    ID3D12CommandList *lists[] = { slot.list.Get() };
+    d.queue->ExecuteCommandLists(1, lists);
+    slot.done = ++d.fence_value;
+    d.queue->Signal(d.fence.Get(), slot.done);
+
+    {
+        std::lock_guard<std::mutex> guard(d.published_mutex);
+        d.published = d.next;
+        d.published_width = width;
+        d.published_height = height;
+    }
+    d.next = (d.next + 1) % Impl::kSlots;
+    if (++d.frames == 1)
+        LOG_INFO("Direct3D 12: first frame ({}x{}) on its way to the screen", width, height);
+    return true;
+}
+
+bool D3D12State::take_frame(uint32_t &width, uint32_t &height) {
+    Impl &d = *impl;
+    const Interface &iface = get_interface();
+    int index;
+    {
+        std::lock_guard<std::mutex> guard(d.published_mutex);
+        if (d.published < 0)
+            return false;
+        index = d.published;
+        width = d.published_width;
+        height = d.published_height;
+        d.taken = index;
+    }
+    if (!iface.set_texture || !d.slots[index].texture)
+        return false;
+    iface.set_texture(iface.handle, d.slots[index].texture.Get(), DXGI_FORMAT_R8G8B8A8_UNORM);
+    return true;
+}
