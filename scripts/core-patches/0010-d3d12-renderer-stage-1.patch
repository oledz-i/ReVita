+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// Xbox (ReVita): the native Direct3D 12 renderer, stage 1 (see state.h).
+
+#include <renderer/d3d12/state.h>
+
+#include <display/state.h>
+#include <util/log.h>
+
+#include <windows.h>
+
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <cstring>
+#include <mutex>
+
+using Microsoft::WRL::ComPtr;
+
+namespace renderer::d3d12 {
+
+namespace {
+Interface g_interface;
+}
+
+void set_interface(const Interface &iface) {
+    g_interface = iface;
+}
+
+const Interface &get_interface() {
+    return g_interface;
+}
+
+struct D3D12State::Impl {
+    static constexpr int kSlots = 3;
+    ID3D12Device *device = nullptr;
+    ID3D12CommandQueue *queue = nullptr;
+    D3D12_RESOURCE_STATES required = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ComPtr<ID3D12Fence> fence;
+    HANDLE event = nullptr;
+    uint64_t fence_value = 0;
+
+    struct Slot {
+        ComPtr<ID3D12CommandAllocator> allocator;
+        ComPtr<ID3D12GraphicsCommandList> list;
+        ComPtr<ID3D12Resource> upload;
+        uint64_t upload_size = 0;
+        ComPtr<ID3D12Resource> texture;
+        uint32_t width = 0;
+        uint32_t height = 0;
+        bool fresh = true; // still in the state it was made in (copy destination)
+        uint64_t done = 0; // fence value when its last copy has finished
+    };
+    Slot slots[kSlots];
+    int next = 0;
+
+    std::mutex published_mutex;
+    int published = -1;
+    int taken = -1;
+    uint32_t published_width = 0;
+    uint32_t published_height = 0;
+    uint64_t frames = 0;
+
+    ~Impl() {
+        if (fence && event) {
+            // the queue may still copy into the textures released here
+            const uint64_t last = fence_value;
+            if (fence->GetCompletedValue() < last && SUCCEEDED(fence->SetEventOnCompletion(last, event)))
+                WaitForSingleObjectEx(event, 2000, FALSE);
+        }
+        if (event)
+            CloseHandle(event);
+    }
+};
+
+D3D12State::D3D12State()
+    : impl(std::make_unique<Impl>()) {
+}
+
+D3D12State::~D3D12State() = default;
+
+bool D3D12State::init() {
+    Impl &d = *impl;
+    const Interface &iface = get_interface();
+    d.device = iface.device;
+    d.queue = iface.queue;
+    if (!d.device || !d.queue) {
+        LOG_ERROR("Direct3D 12: the frontend gave no device or queue");
+        return false;
+    }
+    if (iface.required_state)
+        d.required = static_cast<D3D12_RESOURCE_STATES>(iface.required_state);
+    if (FAILED(d.device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&d.fence)))) {
+        LOG_ERROR("Direct3D 12: CreateFence failed");
+        return false;
+    }
+    d.event = CreateEventExW(nullptr, nullptr, 0, EVENT_MODIFY_STATE | SYNCHRONIZE);
+    if (!d.event)
+        return false;
+    for (auto &slot : d.slots) {
+        if (FAILED(d.device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&slot.allocator)))
+            || FAILED(d.device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, slot.allocator.Get(), nullptr, IID_PPV_ARGS(&slot.list)))) {
+            LOG_ERROR("Direct3D 12: could not make a command list");
+            return false;
+        }
+        slot.list->Close();
+    }
+    texture_cache.backend = Backend::D3D12;
+    LOG_INFO("Direct3D 12 renderer (experimental): device ready. Stage 1: guest draws are not drawn yet; the display buffer in memory is shown.");
+    return true;
+}
