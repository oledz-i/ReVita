+// Xbox (ReVita): the native Direct3D 12 renderer, experimental.
+//
+// Stage 1 of docs/D3D12-RENDERER.md in the ReVita repository: the backend
+// exists, can be picked, keeps every guest command flowing (contexts, render
+// targets, programs, notifications and sync objects all behave as they do on
+// the other renderers) and presents the picture the game's display buffer
+// holds in guest memory through the frontend's own Direct3D 12 device. It
+// does not draw yet: GXM draws are accepted and dropped, so a game that
+// draws with the GPU shows black, and one that writes its screen with the
+// CPU shows it.
+
+#pragma once
+
+#include <renderer/state.h>
+#include <renderer/texture_cache.h>
+#include <renderer/types.h>
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+
+struct ID3D12Device;
+struct ID3D12CommandQueue;
+struct ID3D12Resource;
+struct Config;
+
+namespace renderer::d3d12 {
+
+// What the frontend hands over (libretro's retro_hw_render_interface_d3d12)
+struct Interface {
+    void *handle = nullptr;
+    ID3D12Device *device = nullptr;
+    ID3D12CommandQueue *queue = nullptr;
+    // the state the frontend reads a texture in (D3D12_RESOURCE_STATES)
+    uint32_t required_state = 0;
+    // hands the frame to show to the frontend; format is a DXGI_FORMAT
+    void (*set_texture)(void *handle, ID3D12Resource *texture, int format) = nullptr;
+};
+// called from the libretro context reset, before renderer::init
+void set_interface(const Interface &iface);
+const Interface &get_interface();
+
+// No texture work yet: draws are dropped before anything is sampled
+class D3D12TextureCache final : public TextureCache {
+public:
+    void select(size_t index, const SceGxmTexture &texture) override {}
+    void configure_texture(const SceGxmTexture &texture) override {}
+    void upload_texture_impl(SceGxmTextureBaseFormat base_format, uint32_t width, uint32_t height, uint32_t mip_index, const void *pixels, int face, uint32_t pixels_per_stride) override {}
+    void import_configure_impl(SceGxmTextureBaseFormat base_format, uint32_t width, uint32_t height, bool is_srgb, uint16_t nb_components, uint16_t mipcount, bool swap_rb) override {}
+};
+
+struct D3D12Context : public renderer::Context {};
+struct D3D12RenderTarget : public renderer::RenderTarget {};
+
+struct D3D12State : public renderer::State {
+    D3D12State();
+    ~D3D12State() override;
+
+    D3D12TextureCache texture_cache;
+
+    bool init() override;
+    void late_init(const Config &cfg, const std::string_view game_id, MemState &mem) override;
+    TextureCache *get_texture_cache() override { return &texture_cache; }
+    void render_frame(DisplayState &display, const GxmState &gxm, MemState &mem) override;
+    void swap_window() override {}
+    std::vector<uint32_t> dump_frame(DisplayState &display, uint32_t &width, uint32_t &height) override;
+    int get_supported_filters() override;
+    void set_screen_filter(const std::string_view &filter) override {}
+    int get_max_anisotropic_filtering() override { return 1; }
+    void set_anisotropic_filtering(int anisotropic_filtering) override {}
+    int get_max_2d_texture_width() override { return 16384; }
+    std::string_view get_gpu_name() override { return "Direct3D 12 (experimental)"; }
+    void precompile_shader(const ShadersHash &hash) override {}
+    void preclose_action() override {}
+
+    // Render thread: the RGBA8 picture at pixels (pitch in pixels) into the
+    // next of three textures, which retro_run then hands to the frontend.
+    bool present_from_memory(const void *pixels, uint32_t pitch, uint32_t width, uint32_t height);
+    // retro_run: the newest finished frame, if one was made since the last
+    // call (its texture goes to the frontend through set_texture)
+    bool take_frame(uint32_t &width, uint32_t &height);
+
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+
+bool create(std::unique_ptr<renderer::State> &state, const Config &config);
+bool create(std::unique_ptr<renderer::Context> &context);
+bool create(std::unique_ptr<renderer::RenderTarget> &rt);
+void create(std::unique_ptr<renderer::FragmentProgram> &fp);
+void create(std::unique_ptr<renderer::VertexProgram> &vp);
+
+} // namespace renderer::d3d12
