+#ifdef VITA3K_UWP
+// Programmable blending on the console. Vita3K reads the render target through
+// an input attachment while drawing to it; Direct3D 12 has no such feedback
+// (the console's GPU keeps render targets compressed, and a draw reading the
+// target it renders to read black: the black boxes behind Persona 4 Golden's
+// menu text and sprites). A draw that reads the target now reads a copy taken
+// just before it, the way the OpenGL renderer does.
+namespace {
+struct UwpFetchCopy {
+    std::unique_ptr<vkutil::Image> image;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    vk::Format format{};
+};
+std::vector<UwpFetchCopy> uwp_fetch_copies;
+int uwp_fetch_copies_this_scene = 0;
+int uwp_fetch_reuses_left = 0;
+} // namespace
+
+vkutil::Image *uwp_fetch_image(uint32_t width, uint32_t height, vk::Format format, bool create) {
+    for (auto &copy : uwp_fetch_copies)
+        if (copy.width == width && copy.height == height && copy.format == format)
+            return copy.image.get();
+    if (!create || uwp_fetch_copies.size() >= 12 || width == 0 || height == 0)
+        return nullptr;
+    UwpFetchCopy copy;
+    copy.image = std::make_unique<vkutil::Image>(width, height, format);
+    copy.image->init_image(vk::ImageUsageFlagBits::eTransferDst | vk::ImageUsageFlagBits::eSampled | vk::ImageUsageFlagBits::eInputAttachment);
+    copy.width = width;
+    copy.height = height;
+    copy.format = format;
+    LOG_INFO("Programmable blending: render target copy {}x{} ({})", width, height, vk::to_string(format));
+    uwp_fetch_copies.push_back(std::move(copy));
+    return uwp_fetch_copies.back().image.get();
+}
+
+// Whether the draw about to read the target needs a fresh copy: every such
+// draw does for the first 300 of a scene; past that (a scene that blends
+// hundreds of times) a copy is shared by 16 draws to keep the GPU on time.
+bool uwp_fetch_copy_needed() {
+    if (uwp_fetch_copies_this_scene < 300 || uwp_fetch_reuses_left <= 0) {
+        ++uwp_fetch_copies_this_scene;
+        uwp_fetch_reuses_left = uwp_fetch_copies_this_scene < 300 ? 0 : 16;
+        return true;
+    }
+    --uwp_fetch_reuses_left;
+    return false;
+}
+
+void uwp_fetch_copy(VKContext &context, vkutil::Image &copy) {
+    vkutil::Image *source = context.current_color_base_image;
+    const vk::ImageMemoryBarrier to_copy{
+        .srcAccessMask = vk::AccessFlagBits::eColorAttachmentWrite,
+        .dstAccessMask = vk::AccessFlagBits::eTransferRead,
+        .oldLayout = vk::ImageLayout::eGeneral,
+        .newLayout = vk::ImageLayout::eGeneral,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = source->image,
+        .subresourceRange = vkutil::color_subresource_range
+    };
+    context.render_cmd.pipelineBarrier(vk::PipelineStageFlagBits::eColorAttachmentOutput, vk::PipelineStageFlagBits::eTransfer, {}, {}, {}, to_copy);
+    copy.transition_to_discard(context.render_cmd, vkutil::ImageLayout::TransferDst);
+    const vk::ImageCopy region{
+        .srcSubresource = vkutil::color_subresource_layer,
+        .srcOffset = { 0, 0, 0 },
+        .dstSubresource = vkutil::color_subresource_layer,
+        .dstOffset = { 0, 0, 0 },
+        .extent = { std::min(source->width, copy.width), std::min(source->height, copy.height), 1 }
+    };
+    context.render_cmd.copyImage(source->image, vk::ImageLayout::eGeneral, copy.image, vk::ImageLayout::eTransferDstOptimal, region);
+    copy.transition_to(context.render_cmd, vkutil::ImageLayout::StorageImage);
+    const vk::ImageMemoryBarrier back{
+        .srcAccessMask = vk::AccessFlagBits::eTransferRead,
+        .dstAccessMask = vk::AccessFlagBits::eColorAttachmentRead | vk::AccessFlagBits::eColorAttachmentWrite,
+        .oldLayout = vk::ImageLayout::eGeneral,
+        .newLayout = vk::ImageLayout::eGeneral,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = source->image,
+        .subresourceRange = vkutil::color_subresource_range
+    };
+    context.render_cmd.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eColorAttachmentOutput, {}, {}, {}, back);
+}
