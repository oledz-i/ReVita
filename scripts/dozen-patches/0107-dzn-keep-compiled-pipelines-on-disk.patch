From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oledz-i <x@x>
Date: Wed, 4 Nov 2026 21:00:00 -0500
Subject: [PATCH] dzn: keep each compiled pipeline on disk (cached PSO blobs)

---
diff --git a/src/microsoft/vulkan/dzn_pipeline.c b/src/microsoft/vulkan/dzn_pipeline.c
index 174c246..92c27f5 100644
--- a/src/microsoft/vulkan/dzn_pipeline.c
+++ b/src/microsoft/vulkan/dzn_pipeline.c
@@ -2735,12 +2735,213 @@ vita3k_create_pso_guarded(struct dzn_device *device, const D3D12_PIPELINE_STATE_
 
 /* CreatePipelineState through the library: load when known, compile and keep when not. */
 static HRESULT
+#include <wchar.h>
+
+/* VITA3K: compiled pipelines kept on disk, one file each.
+ *
+ * The Xbox's driver takes 30-750 ms to compile each pipeline state (about
+ * 240 ms on average in Danganronpa Another Episode, where 26 of them made the
+ * first minute hitch for 6 s), and nothing kept the result between sessions:
+ * a D3D12 pipeline library removed the GPU device on the console (the
+ * frontend no longer asks for one). A single pipeline's own cached blob
+ * (GetCachedBlob, then CACHED_PSO when it is made again) is a different,
+ * simpler path. VITA3K_PSO_DIR names the game's folder; each pipeline is a
+ * file named by the same hash as the library used. A blob the driver refuses
+ * is deleted and the pipeline compiled as usual; if the device is lost right
+ * after a cached pipeline was made, a "disabled" file turns the cache off
+ * for that game for good. */
+static struct {
+   mtx_t lock;
+   bool inited;
+   char dir[400];
+   WCHAR wdir[400];
+   bool on;
+   unsigned hits, stores, refused;
+} vita3k_blob;
+
+static bool
+vita3k_blob_enabled(void)
+{
+   static volatile LONG gate;
+   while (InterlockedCompareExchange(&gate, 1, 0) != 0)
+      Sleep(0);
+   if (!vita3k_blob.inited) {
+      mtx_init(&vita3k_blob.lock, mtx_plain);
+      vita3k_blob.inited = true;
+   }
+   InterlockedExchange(&gate, 0);
+
+   char now[400];
+   DWORD n = GetEnvironmentVariableA("VITA3K_PSO_DIR", now, sizeof(now));
+   if (n == 0 || n >= sizeof(now) - 64)
+      now[0] = 0;
+   mtx_lock(&vita3k_blob.lock);
+   if (strcmp(now, vita3k_blob.dir) != 0) {
+      /* another game (or none): look again */
+      strcpy(vita3k_blob.dir, now);
+      vita3k_blob.on = false;
+      vita3k_blob.hits = vita3k_blob.stores = vita3k_blob.refused = 0;
+      if (now[0] && MultiByteToWideChar(CP_UTF8, 0, now, -1, vita3k_blob.wdir, 400)) {
+         WCHAR marker[460];
+         swprintf(marker, 460, L"%ls\\disabled", vita3k_blob.wdir);
+         WIN32_FILE_ATTRIBUTE_DATA attrs;
+         if (GetFileAttributesExW(marker, GetFileExInfoStandard, &attrs)) {
+            mesa_logw("dzn: VITA3K: pipeline disk cache is off for this game (the GPU failed with it before)");
+         } else {
+            vita3k_blob.on = true;
+            mesa_logw("dzn: VITA3K: pipeline disk cache on");
+         }
+      }
+   }
+   const bool on = vita3k_blob.on;
+   mtx_unlock(&vita3k_blob.lock);
+   return on;
+}
+
+static void
+vita3k_blob_path(WCHAR *path, size_t count, const WCHAR name[40], const WCHAR *suffix)
+{
+   swprintf(path, count, L"%ls\\%ls%ls", vita3k_blob.wdir, name, suffix);
+}
+
+static void *
+vita3k_blob_read(const WCHAR *path, DWORD *size)
+{
+   CREATEFILE2_EXTENDED_PARAMETERS ext = { sizeof(ext), FILE_ATTRIBUTE_NORMAL };
+   HANDLE f = CreateFile2(path, GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING, &ext);
+   if (f == INVALID_HANDLE_VALUE)
+      return NULL;
+   void *data = NULL;
+   LARGE_INTEGER sz;
+   if (GetFileSizeEx(f, &sz) && sz.QuadPart > 0 && sz.QuadPart < (64ll << 20)) {
+      data = malloc((size_t)sz.QuadPart);
+      DWORD got = 0;
+      if (data && ReadFile(f, data, (DWORD)sz.QuadPart, &got, NULL) && got == sz.QuadPart) {
+         *size = got;
+      } else {
+         free(data);
+         data = NULL;
+      }
+   }
+   CloseHandle(f);
+   return data;
+}
+
+static void
+vita3k_blob_store(const WCHAR name[40], ID3D12PipelineState *pso)
+{
+   ID3DBlob *blob = NULL;
+   if (FAILED(ID3D12PipelineState_GetCachedBlob(pso, &blob)) || !blob)
+      return;
+   const void *data = ID3D10Blob_GetBufferPointer(blob);
+   const SIZE_T size = ID3D10Blob_GetBufferSize(blob);
+   WCHAR tmp[460], final_path[460];
+   vita3k_blob_path(tmp, 460, name, L".tmp");
+   vita3k_blob_path(final_path, 460, name, L".pso");
+   bool ok = false;
+   if (data && size && size < (64u << 20)) {
+      CREATEFILE2_EXTENDED_PARAMETERS ext = { sizeof(ext), FILE_ATTRIBUTE_NORMAL };
+      HANDLE f = CreateFile2(tmp, GENERIC_WRITE, 0, CREATE_ALWAYS, &ext);
+      if (f != INVALID_HANDLE_VALUE) {
+         DWORD written = 0;
+         ok = WriteFile(f, data, (DWORD)size, &written, NULL) && written == size;
+         CloseHandle(f);
+         if (ok)
+            ok = MoveFileExW(tmp, final_path, MOVEFILE_REPLACE_EXISTING);
+         if (!ok)
+            DeleteFileW(tmp);
+      }
+   }
+   ID3D10Blob_Release(blob);
+   if (ok) {
+      mtx_lock(&vita3k_blob.lock);
+      const unsigned stores = ++vita3k_blob.stores;
+      mtx_unlock(&vita3k_blob.lock);
+      if (stores == 1 || stores % 25 == 0)
+         mesa_logw("dzn: VITA3K: pipeline disk cache: %u stored this session", stores);
+   }
+}
+
+/* Made from its cached blob; NULL result (and S_FALSE) when there is none. */
+static HRESULT
+vita3k_blob_create(struct dzn_device *device, const D3D12_PIPELINE_STATE_STREAM_DESC *sd,
+                   const WCHAR name[40], ID3D12PipelineState **out)
+{
+   WCHAR path[460];
+   vita3k_blob_path(path, 460, name, L".pso");
+   DWORD size = 0;
+   void *data = vita3k_blob_read(path, &size);
+   if (!data)
+      return S_FALSE;
+
+   struct vita3k_cached_pso {
+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type;
+      D3D12_CACHED_PIPELINE_STATE desc;
+   };
+   const size_t base = ALIGN_POT(sd->SizeInBytes, alignof(void *));
+   uint8_t *stream = calloc(1, base + sizeof(struct vita3k_cached_pso));
+   if (!stream) {
+      free(data);
+      return S_FALSE;
+   }
+   memcpy(stream, sd->pPipelineStateSubobjectStream, sd->SizeInBytes);
+   struct vita3k_cached_pso *cached = (void *)(stream + base);
+   cached->type = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CACHED_PSO;
+   cached->desc.pCachedBlob = data;
+   cached->desc.CachedBlobSizeInBytes = size;
+   const D3D12_PIPELINE_STATE_STREAM_DESC with_blob = {
+      .SizeInBytes = base + sizeof(struct vita3k_cached_pso),
+      .pPipelineStateSubobjectStream = stream,
+   };
+   HRESULT hres = vita3k_create_pso_guarded(device, &with_blob, out);
+   free(stream);
+   free(data);
+
+   if (FAILED(hres)) {
+      /* a blob from another driver, or a damaged file: compile it again */
+      *out = NULL;
+      DeleteFileW(path);
+      mtx_lock(&vita3k_blob.lock);
+      const unsigned refused = ++vita3k_blob.refused;
+      mtx_unlock(&vita3k_blob.lock);
+      if (refused <= 3)
+         mesa_logw("dzn: VITA3K: cached pipeline refused (0x%08x); compiled again", (unsigned)hres);
+      return S_FALSE;
+   }
+   if (ID3D12Device4_GetDeviceRemovedReason(device->dev) != S_OK) {
+      WCHAR marker[460];
+      swprintf(marker, 460, L"%ls\\disabled", vita3k_blob.wdir);
+      CREATEFILE2_EXTENDED_PARAMETERS ext = { sizeof(ext), FILE_ATTRIBUTE_NORMAL };
+      HANDLE f = CreateFile2(marker, GENERIC_WRITE, 0, CREATE_ALWAYS, &ext);
+      if (f != INVALID_HANDLE_VALUE)
+         CloseHandle(f);
+      mesa_loge("dzn: VITA3K: the GPU failed right after a cached pipeline; the disk cache is off for this game from now on");
+      return hres;
+   }
+   mtx_lock(&vita3k_blob.lock);
+   const unsigned hits = ++vita3k_blob.hits;
+   mtx_unlock(&vita3k_blob.lock);
+   if (hits == 1 || hits % 25 == 0)
+      mesa_logw("dzn: VITA3K: pipeline disk cache: %u loaded this session", hits);
+   return hres;
+}
+
 onyx_create_pso(struct dzn_device *device, const D3D12_PIPELINE_STATE_STREAM_DESC *sd,
                 ID3D12PipelineState **out)
 {
    ID3D12PipelineLibrary1 *lib = onyx_pso_library(device);
    WCHAR name[40];
    const bool keyed = lib && onyx_pso_name(sd, name);
+   if (!lib && vita3k_blob_enabled() && onyx_pso_name(sd, name)) {
+      const int64_t start = os_time_get_nano();
+      HRESULT bh = vita3k_blob_create(device, sd, name, out);
+      if (bh == S_OK && *out)
+         return bh;
+      HRESULT hres = vita3k_create_pso_guarded(device, sd, out);
+      if (SUCCEEDED(hres) && *out && os_time_get_nano() - start > 5ll * 1000000ll)
+         vita3k_blob_store(name, *out);
+      return hres;
+   }
    if (keyed) {
       mtx_lock(&onyx_pso.lock);
       HRESULT lh = ID3D12PipelineLibrary1_LoadPipeline(lib, name, sd, &IID_ID3D12PipelineState,
